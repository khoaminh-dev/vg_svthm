# ---- Vercel (api/) : đặt trong Vercel > Project Settings > Environment Variables ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=

# Nhiều key, ngăn cách bằng dấu phẩy
GROQ_KEYS=gsk_key1,gsk_key2
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo

ELEVENLABS_KEYS=el_key1,el_key2
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Dự phòng (tuỳ chọn)
GEMINI_KEYS=
GEMINI_MODEL=

# ---- Flutter (app/) : truyền bằng --dart-define hoặc app/.env ----
# SUPABASE_URL, SUPABASE_ANON_KEY, API_BASE_URL=https://api.<domain>

# --- Web admin (/admin) ---
# Bắt buộc để xem thống kê: Supabase > Settings > API > service_role key (BÍ MẬT, chỉ đặt trên Vercel).
SUPABASE_SERVICE_ROLE_KEY=
# Tuỳ chọn (mặc định admin / 123 — nên đổi khi dùng thật)
ADMIN_USER=
ADMIN_PASS=
ADMIN_SESSION_SECRET=

# --- Bảo mật khoá API lưu trong DB (trang admin → Cài đặt) ---
# Bắt buộc để lưu key OpenAI. ≥ 32 ký tự ngẫu nhiên (tạo bằng: [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256}) -as [byte[]]) hoặc openssl rand -base64 32).
# Mất/đổi giá trị này thì các key đã mã hoá không giải được: khi đổi, đặt giá trị cũ vào KEY_ENCRYPTION_SECRET_PREV rồi thêm lại key.
KEY_ENCRYPTION_SECRET=
KEY_ENCRYPTION_SECRET_PREV=

# --- Vy Live (thử nghiệm) ---
# Khoá OpenAI nên thêm qua trang admin (mã hoá trong DB) thay vì biến môi trường; biến này chỉ là dự phòng.
OPENAI_API_KEY=
# Dự phòng cho danh sách "Tài khoản được thử Vy Live" ở trang admin (id người dùng, cách nhau bằng dấu phẩy).
LIVE_ALLOWED_USERS=
# R (mặc định) hoặc C; model backend của chế độ R; JSON thêm vào cấu hình Responses (vd {"reasoning":{"effort":"none"}}).
LIVE_MODE=
LIVE_BACKEND_MODEL=
LIVE_RESPONSES_EXTRA=
