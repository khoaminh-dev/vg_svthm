# ---- Vercel (api/) : đặt trong Vercel > Project Settings > Environment Variables ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=

# Nhiều key, ngăn cách bằng dấu phẩy
GROQ_KEYS=gsk_key1,gsk_key2
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo

ELEVENLABS_KEYS=el_key1,el_key2
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Dự phòng (tuỳ chọn)
GEMINI_KEYS=
GEMINI_MODEL=

# ---- Flutter (app/) : truyền bằng --dart-define hoặc app/.env ----
# SUPABASE_URL, SUPABASE_ANON_KEY, API_BASE_URL=https://api.<domain>

# --- Web admin (/admin) ---
# Bắt buộc để xem thống kê: Supabase > Settings > API > service_role key (BÍ MẬT, chỉ đặt trên Vercel).
SUPABASE_SERVICE_ROLE_KEY=
# Tuỳ chọn (mặc định admin / 123 — nên đổi khi dùng thật)
ADMIN_USER=
ADMIN_PASS=
ADMIN_SESSION_SECRET=
